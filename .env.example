# Copy to .env and edit. Every setting is read with the DH_ prefix.
# .env is gitignored and holds secrets; .env.example is the committed template.

# Drive engine: "mock" (no GPU, full flow works) or "musetalk" (GPU weights required).
DH_DRIVE_ENGINE=mock

# Runtime data dir: SQLite DB, avatar assets, and MuseTalk weights live here.
DH_DATA_DIR=data

# SQLAlchemy database URL.
DH_DATABASE_URL=sqlite:///data/digital-human.db

# Admin console password (login) and the X-Admin-Token checked by the admin API.
# Change both before exposing the service.
DH_ADMIN_PASSWORD=change-me
DH_ADMIN_TOKEN=change-me-too

# Reclaim a session after this many seconds without audio.
DH_SESSION_IDLE_TIMEOUT=60

# How often the idle-reclaim sweep runs, in seconds.
DH_SESSION_SWEEP_INTERVAL=10

# Output video geometry and frame rate.
DH_FRAME_WIDTH=720
DH_FRAME_HEIGHT=1280
DH_FPS=25

# Audio sample rate in Hz (WS PCM and RTP ingest are resampled to this).
DH_SAMPLE_RATE=48000
