# Copy to .env and edit. Every setting is read with the DH_ prefix.
# .env is gitignored and holds secrets; .env.example is the committed template.

# Note: there is deliberately no env var for the digital-human model. Which
# model this box runs (today: MuseTalk) is an operator choice stored in the
# SQLite `settings` table and switched from the Models tab in the admin
# console -- the same place the MiniMax TTS and LLM configs live.

# Runtime data dir: SQLite DB, avatar assets, and MuseTalk weights live here.
DH_DATA_DIR=data

# SQLAlchemy database URL.
DH_DATABASE_URL=sqlite:///data/digital-human.db

# Reclaim a session after this many seconds without audio.
DH_SESSION_IDLE_TIMEOUT=60

# How often the idle-reclaim sweep runs, in seconds.
DH_SESSION_SWEEP_INTERVAL=10

# Output video geometry and frame rate.
DH_FRAME_WIDTH=720
DH_FRAME_HEIGHT=1280
DH_FPS=25

# Outbound H.264 bitrate, in bits per second. aiortc's OpenH264 defaults to
# 1 Mbps with a 3 Mbps REMB ceiling; at 720x1280@25 the talking mouth is the
# busiest region in the frame and 1 Mbps turns it into blocky noise.
DH_VIDEO_BITRATE=3500000
DH_VIDEO_MAX_BITRATE=4000000

# Audio sample rate in Hz (WS PCM and RTP ingest are resampled to this).
DH_SAMPLE_RATE=48000

# Limits on a driver-video upload. The clip is capped in both seconds and
# frames so a long video can't blow up the engine's resident-frame budget.
# Frames are counted at the output fps: 15 s at 25 fps is 375 frames.
DH_AVATAR_MAX_VIDEO_SECONDS=15
DH_AVATAR_MAX_VIDEO_FRAMES=375
# Uploads are streamed to disk and counted as they arrive; a body past this
# many bytes is refused mid-copy with 413.
DH_AVATAR_MAX_UPLOAD_BYTES=300000000
# How many decoded video avatars the engine keeps resident. Each costs
# ~1 GB of frames, so this stays small.
DH_AVATAR_CACHE_SIZE=2

# Static credential for the business-plane endpoints a *remote* client
# reaches -- today that is the Electron pet. Empty disables the check,
# which is what a single-operator box behind the admin console wants.
DH_V1_API_TOKEN=

# Live2D. The server never renders a Cubism model; it only hosts the
# files and hands them to the browser.
DH_LIVE2D_ENABLED=true
DH_LIVE2D_SDK_DIR=data/CubismSdkForWeb-5-r.5

# Limits on an uploaded Cubism project (a zip). The archive size itself is
# bounded by DH_AVATAR_MAX_UPLOAD_BYTES; these bound what the archive can
# DECLARE and become, because a few hundred KB of zeros expands to
# hundreds of MB and a small archive can declare a million members.
DH_LIVE2D_MAX_ARCHIVE_ENTRIES=512
DH_LIVE2D_MAX_UNPACKED_BYTES=512000000
DH_LIVE2D_MAX_ENTRY_BYTES=64000000
